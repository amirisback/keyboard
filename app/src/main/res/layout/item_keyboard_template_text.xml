<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_feature_card_12dp"
    android:clickable="true"
    android:elevation="1dp"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <View
        android:id="@+id/view_accent_bar"
        android:layout_width="3dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_feature_action_pill"
        android:backgroundTint="@color/color_feature_accent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_item_template_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:maxLines="3"
        android:textColor="@color/tv_text"
        android:textSize="12.5sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/ll_insert_action"
        app:layout_constraintStart_toEndOf="@id/view_accent_bar"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Halo! Terima kasih atas pertanyaannya. Kami akan segera merespons dalam beberapa saat." />

    <LinearLayout
        android:id="@+id/ll_insert_action"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:background="@drawable/bg_feature_action_pill"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_feature_insert"
            app:tint="@color/color_feature_action_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:text="Paste"
            android:textColor="@color/color_feature_action_text"
            android:textSize="10.5sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
